CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Mood board: required for production; Alchemy supplies a local dev secret.
# Use a random value with at least 32 characters.
# BETTER_AUTH_SECRET=
# RESEND_API_KEY=
# EMAIL_SENDER=Moodboard <hello@example.com>

# Optional Google sign-in and additional trusted origins.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TRUSTED_ORIGINS=http://localhost:8787
