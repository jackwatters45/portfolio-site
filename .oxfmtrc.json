{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortPackageJson": false,
  "sortImports": {
    "customGroups": [
      { "groupName": "protocol", "elementNamePattern": ["*:*"] }
    ],
    "groups": [
      "protocol",
      "builtin",
      "external",
      "internal",
      ["parent", "sibling", "index"],
      "unknown"
    ],
    "newlinesBetween": false,
    "ignoreCase": false,
    "partitionByNewline": true
  },
  "sortTailwindcss": true,
  "ignorePatterns": [
    "**/*.md",
    "**/*.mdx",
    "**/*.yml",
    "**/*.yaml",
    "**/*.html",
    "**/*.vue",
    "**/*.svelte"
  ],
  "overrides": [
    {
      "files": ["**/*.css"],
      "options": {
        "useTabs": false,
        "tabWidth": 2,
        "singleQuote": false,
        "sortTailwindcss": false
      }
    }
  ]
}
