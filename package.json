{
  "name": "personal-sites",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "alchemy dev",
    "build": "turbo build",
    "typecheck": "tsgo --noEmit && turbo typecheck",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "bun run lint:fix && bun run format"
  },
  "dependencies": {
    "alchemy": "2.0.0-beta.79",
    "effect": "4.0.0-rc.117"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0-rc.117",
    "@effect/platform-node": "4.0.0-rc.117",
    "@oxlint/plugins": "1.85.0",
    "@types/node": "^22.20.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "baseline-browser-mapping": "2.11.25",
    "lefthook": "^1.13.6",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "turbo": "^2.8.16",
    "typescript": "^5.9.3",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
