    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@types/node": "^22.20.1",
    "lefthook": "^1.13.6",
    "typescript": "^5.9.3",
    "turbo": "^2.8.16"
  },
  "engines": {
    "node": "22.x"
  }
