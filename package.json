{
  "name": "personal-sites",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "alchemy dev",
    "build": "turbo build",
