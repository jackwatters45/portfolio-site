{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.cloudflare.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["@cloudflare/workers-types", "node"],
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,
    "composite": true,
    "noEmit": true
  },
  "include": [
    "src/cloudflare",
    "src/server/auth.ts",
    "src/server/board-repo.ts",
    "src/server/board-service.ts",
    "src/server/migrations.ts",
    "src/server/media-client-identity.ts",
    "src/server/media-handlers.ts",
    "src/server/media-object-store.ts",
    "src/server/media-repo.ts",
    "src/server/media-service.ts",
    "src/server/public-handlers.ts",
    "src/server/publishing-repo.ts",
    "src/server/request-auth.ts",
    "src/server/publishing-service.ts",
    "src/server/website-preview-fetcher.ts",
    "src/server/website-preview-parser.ts",
    "src/server/website-preview-service.ts",
    "src/server/x-post-preview-parser.ts",
    "src/server/catalog-route.ts",
    "src/server/magic-link.ts",
    "src/server/public-media.ts",
    "src/server/security-headers.ts",
    "src/server/sqlite.ts",
    "src/lib",
    "tests/cloudflare"
  ]
}
