---
import { NAME_LIMIT } from '../../lib/comments-schema';
---
<nz-comment-name-form hidden>
  <form class="nz-comment-form" data-name-form>
    <label for="nz-comment-name">Name</label>
    <input id="nz-comment-name" name="name" autocomplete="name" maxlength={NAME_LIMIT} required />
    <p class="nz-comment-notice">Saved in this browser. Names and comments are public on GitHub.</p>
    <button class="nz-comment-primary" type="submit" disabled>Continue</button>
  </form>
</nz-comment-name-form>
<script>
  import { validName } from '../../lib/comments-schema';
  import { element } from '../../scripts/comments/dom';
  import type { CommentsState } from '../../scripts/comments/state';

  class CommentNameForm extends HTMLElement {
    render(state: CommentsState) {
      this.hidden = state.view !== 'name';
      const input = element<HTMLInputElement>(this, 'input');
      if (input.value !== state.nameInput) input.value = state.nameInput;
      element<HTMLButtonElement>(this, 'button').disabled = !validName(state.nameInput.trim());
    }
  }
  customElements.define('nz-comment-name-form', CommentNameForm);
</script>
