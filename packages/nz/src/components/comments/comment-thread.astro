---
import { COMMENT_LIMIT } from '../../lib/comments-schema';
---
<nz-comment-thread hidden>
  <button class="nz-comment-context" type="button" data-action="context" hidden></button>
  <p class="nz-comment-context" data-context-quote hidden></p>
  <div data-messages></div>
  <output data-thread-loading hidden>Loading…</output>
  <p class="nz-comment-error" data-thread-error role="alert" hidden></p>
  <p class="nz-comment-empty" data-thread-closed hidden></p>
  <button type="button" class="nz-comment-primary" data-action="ask-name" hidden>Add your name to comment</button>
  <form class="nz-comment-form" data-comment-form hidden>
    <label for="nz-comment-body">Comment</label>
    <textarea id="nz-comment-body" name="body" rows="3" maxlength={COMMENT_LIMIT} required></textarea>
    <p class="nz-comment-error" data-send-error role="alert" hidden></p>
    <button type="submit" class="nz-comment-primary" disabled>Post comment</button>
  </form>
  <template data-message-template>
    <article class="nz-comment-message">
      <div class="nz-comment-byline"><strong data-author></strong><time></time></div>
      <p data-body></p>
    </article>
  </template>
</nz-comment-thread>
<script>
  import type { CommentMessage } from '../../lib/comments-schema';
  import { cloneTemplate, element } from '../../scripts/comments/dom';
  import { currentThread, draftKey, type CommentsState } from '../../scripts/comments/state';

  class CommentThread extends HTMLElement {
    private previous?: CommentsState;

    private message(value: CommentMessage) {
      const node = cloneTemplate(this, '[data-message-template]');
      element(node, '[data-author]').textContent = value.name;
      element(node, '[data-body]').textContent = value.body;
      const date = new Date(value.createdAt);
      const time = element<HTMLTimeElement>(node, 'time');
      time.dateTime = value.createdAt;
      time.title = date.toLocaleString();
      time.textContent = date.toLocaleDateString(undefined, { day: 'numeric', month: 'short' });
      return node;
    }

    render(state: CommentsState, hasContext = false) {
      this.hidden = state.view !== 'thread' && state.view !== 'new';
      const previous = this.previous;
      this.previous = state;
      const current = currentThread(state);
      const isThread = state.view === 'thread';
      const context = isThread ? current : state.target;
      const link = element(this, '[data-action="context"]');
      link.hidden = !hasContext;
      link.textContent = context?.quote ?? '';
      const quote = element(this, '[data-context-quote]');
      quote.hidden = hasContext || !isThread;
      quote.textContent = context?.quote ?? '';
      if (previous?.detail !== state.detail || previous?.threadId !== state.threadId ||
        previous?.threads !== state.threads || previous?.view !== state.view) {
        const replies = state.detail?.thread.id === state.threadId ? state.detail.replies : [];
        element(this, '[data-messages]').replaceChildren(...(isThread && current
          ? [current.message, ...replies].map((value) => this.message(value)) : []));
      }
      element(this, '[data-thread-loading]').hidden = !isThread || !state.loadingThread;
      const error = element(this, '[data-thread-error]');
      error.hidden = !isThread || !state.threadError;
      error.textContent = state.threadError;
      const closed = isThread && !!(current?.closed || current?.locked);
      const notice = element(this, '[data-thread-closed]');
      notice.hidden = !closed;
      notice.textContent = current?.closed ? 'Resolved' : 'Replies are closed.';
      element(this, '[data-action="ask-name"]').hidden = closed || !!state.name;
      const form = element<HTMLFormElement>(this, 'form');
      form.hidden = closed || !state.name;
      element(form, 'label').textContent = isThread ? 'Reply' : 'Comment';
      const input = element<HTMLTextAreaElement>(form, 'textarea');
      const draft = state.drafts[draftKey(state)] ?? '';
      if (input.value !== draft) input.value = draft;
      input.disabled = state.sending;
      const sendError = element(form, '[data-send-error]');
      sendError.hidden = !state.sendError;
      sendError.textContent = state.sendError;
      const submit = element<HTMLButtonElement>(form, '[type="submit"]');
      submit.disabled = state.sending || !draft.trim() || (isThread && (state.loadingThread || !!state.threadError));
      submit.textContent = state.sending ? 'Posting…' : isThread ? 'Reply' : 'Post comment';
    }
  }
  customElements.define('nz-comment-thread', CommentThread);
</script>
