---
import '../styles/global.css';
import '../../theme.css';
import { Agentation } from 'agentation';
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Illustration Studies — Queenstown</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="page" id="top">
      <a class="skip" href="#main">Skip to content</a>
      <header class="site-header">
        <a class="site-title" href="/">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="0.7" />
            <path d="M12 1L14 10L23 12L14 14L12 23L10 14L1 12L10 10Z" fill="currentColor" />
            <circle cx="12" cy="12" r="1.7" fill="var(--paper)" />
          </svg>
          New Zealand
        </a>
        <a class="edition" href="/">Back to trip</a>
      </header>

      <main id="main">
        <h1>Illustration studies</h1>
        <section class="illustration-studies" aria-label="Queenstown illustration studies">
          <figure class="illustration-study illustration-study--painted">
            <img src="/images/queenstown-painted.webp" width="915" height="548" loading="lazy" decoding="async" alt="A loose brush-painted view of the Remarkables, Lake Wakatipu, and Queenstown's wooded peninsulas in muted green and brown." />
            <figcaption>01 · Painted</figcaption>
          </figure>
          <figure class="illustration-study illustration-study--stamped">
            <img src="/images/queenstown-stamped.webp" width="1119" height="533" loading="lazy" decoding="async" alt="A worn green-and-brown rubber stamp of Queenstown's mountain ridge, lake, and wooded peninsulas." />
            <figcaption>02 · Stamped</figcaption>
          </figure>
          <figure class="illustration-study">
            <img src="/images/queenstown-pencil.webp" width="1264" height="632" loading="lazy" decoding="async" alt="A loose green pencil sketch of Queenstown's mountains and shoreline, with light hatching and a small brown hillside." />
            <figcaption>03 · Pencil</figcaption>
          </figure>
          <figure class="illustration-study">
            <img src="/images/queenstown-brush.webp" width="1141" height="740" loading="lazy" decoding="async" alt="Broad dry-brush strokes in forest green, sage, and brown suggest snowy mountains and Lake Wakatipu." />
            <figcaption>04 · Dry brush</figcaption>
          </figure>
          <figure class="illustration-study illustration-study--carved">
            <img src="/images/queenstown-carved.webp" width="1134" height="575" loading="lazy" decoding="async" alt="A bold carved print of Queenstown, with white snow channels and worn gaps in dark green ink." />
            <figcaption>05 · Carved</figcaption>
          </figure>
          <figure class="illustration-study">
            <img src="/images/queenstown-ink-wash.webp" width="1199" height="553" loading="lazy" decoding="async" alt="A soft green ink wash of Queenstown's mountains and wooded peninsulas, with a small brown hill and open lake." />
            <figcaption>06 · Ink wash</figcaption>
          </figure>
          <figure class="illustration-study">
            <img src="/images/queenstown-stipple.webp" width="1209" height="547" loading="lazy" decoding="async" alt="Hand-placed green and brown dots trace the Remarkables, Queenstown's hills, and the shore of Lake Wakatipu." />
            <figcaption>07 · Stippled</figcaption>
          </figure>
          <figure class="illustration-study">
            <img src="/images/queenstown-screenprint.webp" width="1164" height="546" loading="lazy" decoding="async" alt="Overlapping forest-green, sage, and brown screenprint shapes form Queenstown's mountain ridge and wooded peninsulas." />
            <figcaption>08 · Screenprint</figcaption>
          </figure>
          <figure class="illustration-study">
            <img src="/images/queenstown-torn-paper.webp" width="1213" height="553" loading="lazy" decoding="async" alt="Torn green, sage, and brown paper shapes form Queenstown's jagged mountains and wooded peninsulas." />
            <figcaption>09 · Torn paper</figcaption>
          </figure>
          <figure class="illustration-study">
            <img src="/images/queenstown-crayon.webp" width="1250" height="559" loading="lazy" decoding="async" alt="Grainy green and brown wax-crayon marks sketch the Remarkables and the shore of Lake Wakatipu." />
            <figcaption>10 · Wax crayon</figcaption>
          </figure>
          <figure class="illustration-study">
            <img src="/images/queenstown-etching.webp" width="1263" height="642" loading="lazy" decoding="async" alt="Fine green crosshatched lines describe Queenstown's mountain faces, hills, and wooded shore." />
            <figcaption>11 · Etched</figcaption>
          </figure>
          <figure class="illustration-study">
            <img src="/images/queenstown-monotype.webp" width="1210" height="560" loading="lazy" decoding="async" alt="A dark green monotype of Queenstown with soft rolled edges, mottled ink, and open snow and lake shapes." />
            <figcaption>12 · Monotype</figcaption>
          </figure>
          <figure class="illustration-study">
            <img src="/images/queenstown-charcoal.webp" width="1265" height="656" loading="lazy" decoding="async" alt="Powdery charcoal strokes and a small brown accent sketch Queenstown's mountains and wooded shore." />
            <figcaption>13 · Charcoal</figcaption>
          </figure>
          <figure class="illustration-study">
            <img src="/images/queenstown-sgraffito.webp" width="1221" height="565" loading="lazy" decoding="async" alt="Scratched white snow and shoreline marks cut through brown and green pastel shapes of Queenstown." />
            <figcaption>14 · Sgraffito</figcaption>
          </figure>
          <figure class="illustration-study">
            <img src="/images/queenstown-stitched.webp" width="1195" height="549" loading="lazy" decoding="async" alt="Green running stitches trace the Remarkables, with small embroidered patches for Queenstown's wooded peninsulas." />
            <figcaption>15 · Stitched</figcaption>
          </figure>
          <figure class="illustration-study">
            <img src="/images/queenstown-contours.webp" width="1287" height="680" loading="lazy" decoding="async" alt="An artistic contour-line study of Queenstown, with nested green lines following mountains, hills, and shorelines." />
            <figcaption>16 · Contour study</figcaption>
          </figure>
          <figure class="illustration-study">
            <img src="/images/queenstown-brush-pen.webp" width="1232" height="604" loading="lazy" decoding="async" alt="Tapered green brush-pen strokes capture Queenstown's mountain ridge and wooded peninsulas with a few quick gestures." />
            <figcaption>17 · Brush pen</figcaption>
          </figure>
          <figure class="illustration-study">
            <img src="/images/queenstown-pastel.webp" width="1233" height="678" loading="lazy" decoding="async" alt="Soft sage, green, and brown chalk-pastel shapes suggest the Remarkables and Lake Wakatipu's wooded shore." />
            <figcaption>18 · Soft pastel</figcaption>
          </figure>
          <figure class="illustration-study">
            <img src="/images/queenstown-woodgrain.webp" width="1187" height="619" loading="lazy" decoding="async" alt="A green and brown woodblock-style print of Queenstown, with flowing woodgrain lines inside the landforms." />
            <figcaption>19 · Woodgrain</figcaption>
          </figure>
          <figure class="illustration-study">
            <img src="/images/queenstown-mosaic.webp" width="1167" height="548" loading="lazy" decoding="async" alt="Small irregular green, sage, and brown tiles form Queenstown's mountains and peninsulas, with open gaps for the lake." />
            <figcaption>20 · Tile mosaic</figcaption>
          </figure>
        </section>
      </main>

      <footer class="site-footer">
        <span>Queenstown · Illustration studies</span>
        <a href="#top">Back to top ↑</a>
      </footer>
    </div>
    {import.meta.env.DEV && <Agentation client:only="react" endpoint="http://localhost:4747" />}
  </body>
</html>
