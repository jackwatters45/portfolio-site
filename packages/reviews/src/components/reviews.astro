---
import type { CollectionEntry } from 'astro:content';
import { reviewerName } from '../lib/reviewers';

interface Props {
  ratings: CollectionEntry<'restaurants'>['data']['ratings'];
  showNames?: boolean;
}
const { ratings, showNames = true } = Astro.props;
const entries = Object.entries(ratings).filter(
  ([, rating]) => rating.score !== null || rating.review,
);
const hasGuests = entries.some(
  ([person]) => person !== 'meg' && person !== 'jack',
);
---

<div class:list={['reviews', { 'guest-reviews': hasGuests }]}>
  {entries.map(([person, rating]) => (
    <section data-person={person} aria-label={`${reviewerName(person)}’s review`}>
      {(showNames || rating.score !== null) && <div class="scores"><strong>{showNames && reviewerName(person)}{rating.score !== null && `${showNames ? ' · ' : ''}${rating.score}/10`}</strong></div>}
      {rating.review && <p>{rating.review}</p>}
    </section>
  ))}
</div>
