---
import Layout from '../layouts/layout.astro';
import { getRestaurants } from '../lib/restaurants';

const restaurants = await getRestaurants();
const date = new Intl.DateTimeFormat('en-AU', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<Layout>
      <ol class="restaurant-list" aria-label="Restaurants, most recent visit first">
        {restaurants.map(({ id, data }) => (
          <li>
            <a class="restaurant-entry" href={`/restaurants/${id}/`}>
              <div class="entry-details">
                <div class="entry-meta">
                  <span>{data.suburb}</span>
                  {data.visited && <time datetime={data.visited}>{date.format(new Date(data.visited))}</time>}
                </div>
                <h2>{data.name}</h2>
                {data.items.some((item) => item.name) && <p class="entry-dishes">{data.items.filter((item) => item.name).map((item) => item.name).join(' · ')}</p>}
              </div>
              <div class="entry-end">
                {data.ratings.meg.score !== null && data.ratings.jack.score !== null && (
                  <div class="entry-rating" aria-label="Average of Meg and Jack’s overall scores">
                    <strong>{((data.ratings.meg.score + data.ratings.jack.score) / 2).toFixed(1)}</strong><span class="out-of">/10</span>
                  </div>
                )}
                <svg class="entry-arrow" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 12h15m-6-6 6 6-6 6" /></svg>
              </div>
            </a>
          </li>
        ))}
      </ol>
</Layout>
