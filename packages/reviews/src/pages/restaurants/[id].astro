---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Reviews from '../../components/reviews.astro';
import Layout from '../../layouts/layout.astro';
import { getRestaurants } from '../../lib/restaurants';
import { reviewerName } from '../../lib/reviewers';

export async function getStaticPaths() {
  return (await getRestaurants()).map((restaurant) => ({
    params: { id: restaurant.id },
    props: { restaurant },
  }));
}

interface Props {
  restaurant: CollectionEntry<'restaurants'>;
}

const { restaurant } = Astro.props;

const { data } = restaurant;

const hasOverall = Object.values(data.ratings).some(
  ({ score, review }) => score !== null || review,
);

const hasBreadRating =
  data.glutenFreeBread &&
  Object.values(data.glutenFreeBread).some(
    ({ score, review }) => score !== null || review,
  );

const guests = [
  ...new Set(data.items.flatMap((item) => Object.keys(item.ratings))),
].filter((person) => person !== 'meg' && person !== 'jack');

interface DishGroup {
  id: string;
  title: string;
  items: typeof data.items;
}

const groups: DishGroup[] = [
  { id: 'shared', title: 'Shared dishes', items: [] },
  { id: 'meg-extras', title: 'Meg', items: [] },
  { id: 'jack-extras', title: 'Jack', items: [] },
  ...guests.map((person): DishGroup => ({
    id: `${person}-extras`,
    title: reviewerName(person),
    items: [],
  })),
  { id: 'unrated', title: 'Not yet rated', items: [] },
];

for (const item of data.items.filter((item) => item.name)) {
  const reviewers = Object.entries(item.ratings)
    .filter(([, rating]) => rating.score !== null || Boolean(rating.review))
    .map(([person]) => person);

  const groupId =
    item.shared || reviewers.length > 1
      ? 'shared'
      : reviewers.length === 1
        ? `${reviewers[0]}-extras`
        : 'unrated';

  groups.find((group) => group.id === groupId)!.items.push(item);
}

const { Content } = await render(restaurant);

const visited =
  data.visited &&
  new Intl.DateTimeFormat('en-AU', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(data.visited));

const currency = new Intl.NumberFormat('en-AU', {
  style: 'currency',
  currency: 'AUD',
});
---

<Layout title={data.name} description={`${data.name}, ${data.suburb}. Restaurant and menu item reviews by Meg and Jack.`}>
  <div class="restaurant-heading">
    <h1>{data.name}</h1>
    <div class="meta restaurant-details">
      {data.mapsUrl ? <a href={data.mapsUrl}>{data.address || data.suburb}</a> : <span>{data.address || data.suburb}</span>}
      {visited && <time datetime={data.visited}>{visited}</time>}
    </div>
  </div>
  <div class="visit-notes"><Content /></div>
  {hasOverall && <section class="section" aria-labelledby="overall">
    <h2 id="overall">Overall</h2>
    <Reviews ratings={data.ratings} />
  </section>}
  {groups.filter((group) => group.items.length > 0).map((group) => <section class:list={['section', { 'solo-reviews': group.id !== 'shared' }]} aria-labelledby={group.id}>
    <h2 id={group.id}>{group.title}</h2>
    {group.items.map((item) => (
      <article>
        <div class="menu-line">
          <h3>{item.name}</h3>
          {item.price !== null && <>
            <span class="menu-leader" aria-hidden="true"></span>
            <p class="meta menu-price">{currency.format(item.price)} AUD</p>
          </>}
        </div>
        {item.note && <p>{item.note}</p>}
        <Reviews ratings={item.ratings} showNames={group.id === 'shared' || group.id === 'unrated'} />
      </article>
    ))}
  </section>)}
  {hasBreadRating && data.glutenFreeBread && <section class="section" aria-labelledby="gluten-free-bread">
    <h2 id="gluten-free-bread">Gluten-free bread</h2>
    <Reviews ratings={data.glutenFreeBread} showNames={false} />
  </section>}
</Layout>
