---
import RestaurantLayout from '@personal-sites/reviews/layouts/restaurant';
import type { Restaurant } from '@personal-sites/reviews/restaurants';

export const restaurant: Restaurant = {
  name: 'Juju’s Deli',
  suburb: 'Thornbury',
  address: '750 High St, Thornbury',
  mapsUrl: 'https://www.google.com/maps?cid=2554449490956072179',
  coordinates: [-37.7558208, 145.0013214],
  visited: '2026-08-22',
  dishes: ['Prosciutto', 'Sparkling water', 'Iced strawberry matcha'],
};
---

<RestaurantLayout restaurant={restaurant}>
  <div class="visit-notes">
    <p>Quick trip up to Northcote with Heather before the Men’s State League game after a thrilling U14s victory. Beautiful day and an electric drive had vibes high. Cool little trendy restaurant. Some of the other options looked electric so may have to go back next Brunswick game.</p>
    <p>Jack dropped his sandwich in the road. Turns out lots of earthquakes in Melbourne.</p>
  </div>

  <section class="section" aria-labelledby="shared">
    <h2 id="shared">Shared dishes</h2>
    <article>
      <div class="menu-line">
        <h3>Prosciutto</h3>
      </div>
      <div class="reviews">
        <section data-person="meg" aria-label="Meg’s review">
          <div class="scores"><strong>Meg · 8.6/10</strong></div>
          <p>Think Meg liked it? Don't know I was sorta dying so didn't see her reaction.</p>
        </section>
        <section data-person="jack" aria-label="Jack’s review">
          <div class="scores"><strong>Jack · 8.3/10</strong></div>
          <p>Pretty good sandwich, just not mindblowing. Did almost die and dropped it on the road. The road bites weren't nearly as good as the pre-road ones. Tomatoes do not belong in sandwiches.</p>
        </section>
      </div>
    </article>
  </section>

  <section class="section solo-reviews" aria-labelledby="meg-extras">
    <h2 id="meg-extras">Meg</h2>
    <article>
      <div class="menu-line">
        <h3>Iced strawberry matcha</h3>
      </div>
      <div class="reviews">
        <section data-person="meg" aria-label="Meg’s review">
          <!-- Placeholder until Meg adds her rating. -->
          <div class="scores"><strong>5/10</strong></div>
          <p>Looked cool. Weird taste combo. Don't really know why Meg ordered this. Whatever.</p>
        </section>
      </div>
    </article>
  </section>

  <section class="section solo-reviews" aria-labelledby="jack-extras">
    <h2 id="jack-extras">Jack</h2>
    <article>
      <div class="menu-line">
        <h3>Sparkling water</h3>
      </div>
      <div class="reviews">
        <section data-person="jack" aria-label="Jack’s review">
          <div class="scores"><strong>9.9/10</strong></div>
          <p>Maybe the best sparkling water ever? Only Topo Chico comes close. Still using the bottle today.</p>
        </section>
      </div>
    </article>
  </section>

  <section class="section" aria-labelledby="gluten-free-bread">
    <h2 id="gluten-free-bread">Gluten-free bread</h2>
    <div class="reviews">
      <section data-person="meg" aria-label="Meg’s review">
        <div class="scores"><strong>9/10</strong></div>
      </section>
    </div>
  </section>
</RestaurantLayout>
