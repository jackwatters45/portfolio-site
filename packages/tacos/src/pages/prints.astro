---
import Layout from '@personal-sites/reviews/layouts/base';

const studies = [
  {
    name: 'Lakeside ink wash — detail',
    images: [
      { name: 'Light detail', file: 'lakeside-ink-wash-detail-light', width: 1154, height: 684, alt: 'Taco plates beside Lake Wakatipu in ink wash, with light detail in the food, mountains and trees.' },
      { name: 'Medium detail', file: 'lakeside-ink-wash-detail-medium', width: 1142, height: 689, alt: 'Taco plates beside Lake Wakatipu in ink wash, with medium detail in the food, mountains and trees.' },
      { name: 'High detail', file: 'lakeside-ink-wash-detail-high', width: 1167, height: 688, alt: 'Taco plates beside Lake Wakatipu in ink wash, with high detail in the food, mountains and trees.' },
    ],
  },
  {
    name: 'Lakeside painted — detail',
    images: [
      { name: 'Light detail', file: 'lakeside-painted-detail-light', width: 1169, height: 698, alt: 'Taco plates beside Lake Wakatipu in painted, with light detail in the food, mountains and trees.' },
      { name: 'Medium detail', file: 'lakeside-painted-detail-medium', width: 1169, height: 684, alt: 'Taco plates beside Lake Wakatipu in painted, with medium detail in the food, mountains and trees.' },
      { name: 'High detail', file: 'lakeside-painted-detail-high', width: 1148, height: 686, alt: 'Taco plates beside Lake Wakatipu in painted, with high detail in the food, mountains and trees.' },
    ],
  },
  {
    name: 'Lakeside stamped — detail',
    images: [
      { name: 'Light detail', file: 'lakeside-stamped-detail-light', width: 1163, height: 687, alt: 'Taco plates beside Lake Wakatipu in stamped, with light detail in the food, mountains and trees.' },
      { name: 'Medium detail', file: 'lakeside-stamped-detail-medium', width: 1159, height: 584, alt: 'Taco plates beside Lake Wakatipu in stamped, with medium detail in the food, mountains and trees.' },
      { name: 'High detail', file: 'lakeside-stamped-detail-high', width: 1186, height: 687, alt: 'Taco plates beside Lake Wakatipu in stamped, with high detail in the food, mountains and trees.' },
    ],
  },
  {
    name: 'Close-up',
    images: [
      { name: 'Stamped', file: 'close-up-stamped', width: 914, height: 955, alt: 'Worn brick-red stamp of quesabirria tacos, lime and consommé on a plate.' },
      { name: 'Painted', file: 'close-up-painted', width: 853, height: 904, alt: 'Loose gouache illustration of quesabirria tacos, lime and consommé.' },
      { name: 'Dry brush', file: 'close-up-dry-brush', width: 819, height: 812, alt: 'One plate of quesabirria tacos and consommé in broad, broken gouache strokes.' },
      { name: 'Ink wash', file: 'close-up-ink-wash', width: 915, height: 961, alt: 'Quesabirria tacos, lime and consommé in soft ink washes.' },
    ],
  },
  {
    name: 'Two plates',
    images: [
      { name: 'Stamped', file: 'two-plates-stamped', width: 924, height: 1235, alt: 'Two plates of tacos and consommé arranged diagonally in worn stamp ink.' },
      { name: 'Painted', file: 'two-plates-painted', width: 907, height: 1223, alt: 'Two plates of tacos and consommé painted in brick red, brown and tan.' },
      { name: 'Dry brush', file: 'two-plates-dry-brush', width: 813, height: 1164, alt: 'Two taco plates in broad, broken gouache strokes.' },
      { name: 'Ink wash', file: 'two-plates-ink-wash', width: 921, height: 1229, alt: 'Two taco plates with consommé in soft, pooled ink washes.' },
    ],
  },
  {
    name: 'Lakeside',
    images: [
      { name: 'Stamped', file: 'lakeside-stamped', width: 1156, height: 588, alt: 'Two taco plates beside Lake Wakatipu, with Queenstown mountains in sparse stamp lines.' },
      { name: 'Painted', file: 'lakeside-painted', width: 1168, height: 595, alt: 'Painted taco plates by Lake Wakatipu beneath a loose mountain and tree silhouette.' },
      { name: 'Dry brush', file: 'lakeside-dry-brush', width: 1155, height: 600, alt: 'Taco plates beside Lake Wakatipu with broad dry-brush mountain strokes.' },
      { name: 'Ink wash', file: 'lakeside-ink-wash', width: 1162, height: 587, alt: 'Soft ink-wash tacos beside Lake Wakatipu with sparse mountains and trees.' },
    ],
  },
];
---

<Layout title="Prints" description="Taco's Land illustration studies in selected handmade styles.">
  <div class="prints-page">
    <h1>Prints</h1>
    {studies.map((study) => (
      <section aria-label={study.name}>
        <h2>{study.name}</h2>
        <div class="print-variants">
          {study.images.map((art) => (
            <figure>
              <a href={`/prints/tacos-land/${art.file}.webp`} aria-label={`Open ${study.name.toLowerCase()} ${art.name.toLowerCase()} illustration`}>
                <img src={`/prints/tacos-land/${art.file}.webp`} width={art.width} height={art.height} alt={art.alt} loading="lazy" decoding="async" />
              </a>
              <figcaption>{art.name}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>
