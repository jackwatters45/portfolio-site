---
import '../styles/global.css';
import BackgroundPrints from '../components/background-prints.astro';

interface Props {
  title: string;
  description?: string;
  map?: boolean;
}

const {
  title,
  map = false,
  description = 'Melbourne taco reviews by Meg and Jack. Two scores for every restaurant and menu item.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} · tacos of melbourne</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · tacos of melbourne`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body class:list={{ 'map-page': map }}>
    {!map && <BackgroundPrints />}
    <a class="skip" href="#main">Skip to content</a>
    <header>
      <a class="site-title" href="/">tacos of melbourne</a>
      {Astro.url.pathname === '/' && <a class="map-link" href="/map/">Map</a>}
    </header>
    <main id="main"><slot /></main>
  </body>
</html>
