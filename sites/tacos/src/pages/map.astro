---
import 'leaflet/dist/leaflet.css';
import Layout from '../layouts/layout.astro';
import { getRestaurants } from '../lib/restaurants';

const restaurants = await getRestaurants();
const locations = restaurants.flatMap(({ id, data }) =>
  data.coordinates
    ? [
        {
          name: data.name,
          address: data.address ?? data.suburb,
          coordinates: data.coordinates,
          scores: {
            meg: data.ratings.meg.score,
            jack: data.ratings.jack.score,
          },
          url: `/restaurants/${id}/`,
        },
      ]
    : [],
);
---

<Layout title="Melbourne taco map" description="Find our reviewed taco restaurants on a map of Melbourne." map>
  <div class="map-container">
    <div id="restaurant-map" aria-label="Melbourne taco restaurants" data-locations={JSON.stringify(locations)}></div>
    <p id="map-status" role="status">Loading map… <a href="/">View restaurant list</a></p>
    <noscript><p class="map-notice">Enable JavaScript to use the map. <a href="/">View restaurant list</a></p></noscript>
  </div>
</Layout>

<script>
  import L from 'leaflet';

  const container = document.querySelector<HTMLElement>('#restaurant-map')!;
  const status = document.querySelector<HTMLElement>('#map-status')!;
  const locations: { name: string; address: string; coordinates: [number, number]; scores: { meg: number | null; jack: number | null }; url: string }[] = JSON.parse(container.dataset.locations!);

  const map = L.map(container, { zoomControl: true, fadeAnimation: false, zoomAnimation: false, markerZoomAnimation: false }).setView([-37.8136, 144.9631], 12);
  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
  }).on('tileerror', () => {
    status.hidden = false;
    status.firstChild!.textContent = 'Map tiles could not load. ';
  }).addTo(map);

  for (const location of locations) {
    const popup = document.createElement('div');
    const link = document.createElement('a');
    link.href = location.url;
    link.textContent = location.name;
    const address = document.createElement('p');
    address.textContent = location.address;
    const scores = document.createElement('div');
    scores.className = 'map-scores';
    for (const person of ['meg', 'jack'] as const) {
      if (location.scores[person] === null) continue;
      const rating = document.createElement('div');
      const label = document.createElement('span');
      label.textContent = person === 'meg' ? 'Meg' : 'Jack';
      const score = document.createElement('strong');
      score.textContent = `${location.scores[person]}/10`;
      rating.append(label, score);
      scores.append(rating);
    }
    popup.append(link, address);
    if (scores.childElementCount > 0) popup.append(scores);
    const marker = L.marker(location.coordinates, {
      alt: location.name,
      riseOnHover: true,
      icon: L.divIcon({
        className: 'restaurant-pin',
        html: '<span class="taco-tag" aria-hidden="true"><svg width="30" height="26" viewBox="0 0 32 28" fill="none"><path d="M4 19C1 12 6 4 13 5c3-5 9-2 10 1 6-1 9 5 6 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M3 22a13 13 0 0 1 26 0Z" fill="currentColor"/><path d="m9 18 2-2m5 3 1-3m5 3 1 1" stroke="#fbf3e3" stroke-width="2" stroke-linecap="round"/></svg></span>',
        iconSize: [48, 58], iconAnchor: [24, 58], popupAnchor: [0, -52],
      }),
    }).addTo(map).bindPopup(popup, { className: 'taco-preview', minWidth: 220, maxWidth: 260 });
    marker.on('mouseover click', () => marker.openPopup());
    marker.getElement()?.setAttribute('aria-label', location.name);
    marker.getElement()?.addEventListener('focus', () => marker.openPopup());
  }

  if (locations.length > 0) {
    // Keep central Melbourne in view as the restaurant collection grows.
    map.fitBounds(L.latLngBounds([[-37.8136, 144.9631], ...locations.map(({ coordinates }) => coordinates)]), { padding: [48, 48], maxZoom: 13 });
    status.hidden = true;
  } else {
    status.firstChild!.textContent = 'No mapped reviews yet. ';
  }
</script>
