---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Reviews from '../../components/reviews.astro';
import Layout from '../../layouts/layout.astro';
import { getRestaurants } from '../../lib/restaurants';

export async function getStaticPaths() {
  return (await getRestaurants()).map((restaurant) => ({
    params: { id: restaurant.id },
    props: { restaurant },
  }));
}

interface Props {
  restaurant: CollectionEntry<'restaurants'>;
}
const { restaurant } = Astro.props;
const { data } = restaurant;
const hasOverall = Object.values(data.ratings).some(
  ({ score, review }) => score !== null || review,
);
const groups = [
  { id: 'shared', title: 'Shared dishes', items: [] as typeof data.items },
  { id: 'meg-extras', title: 'Meg’s extras', items: [] as typeof data.items },
  { id: 'jack-extras', title: 'Jack’s extras', items: [] as typeof data.items },
  { id: 'unrated', title: 'Not yet rated', items: [] as typeof data.items },
];
for (const item of data.items.filter((item) => item.name)) {
  const meg =
    item.ratings.meg.score !== null || Boolean(item.ratings.meg.review);
  const jack =
    item.ratings.jack.score !== null || Boolean(item.ratings.jack.review);
  const group = item.shared || (meg && jack) ? 0 : meg ? 1 : jack ? 2 : 3;
  groups[group].items.push(item);
}
const { Content } = await render(restaurant);
const visited =
  data.visited &&
  new Intl.DateTimeFormat('en-AU', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(data.visited));
const currency = new Intl.NumberFormat('en-AU', {
  style: 'currency',
  currency: 'AUD',
});
---

<Layout title={data.name} description={`${data.name}, ${data.suburb}. Restaurant and menu item reviews by Meg and Jack.`}>
  <div class="restaurant-heading">
    <h1>{data.name}</h1>
    <div class="meta restaurant-details">
      {data.mapsUrl ? <a href={data.mapsUrl}>{data.address || data.suburb}</a> : <span>{data.address || data.suburb}</span>}
      {visited && <time datetime={data.visited}>{visited}</time>}
    </div>
  </div>
  <div class="visit-notes"><Content /></div>
  {hasOverall && <section class="section" aria-labelledby="overall">
    <h2 id="overall">Overall</h2>
    <Reviews ratings={data.ratings} />
  </section>}
  {groups.filter((group) => group.items.length > 0).map((group) => <section class:list={['section', { 'solo-reviews': group.id !== 'shared' }]} aria-labelledby={group.id}>
    <h2 id={group.id}>{group.title}</h2>
    {group.items.map((item) => (
      <article>
        <div class="menu-line">
          <h3>{item.name}</h3>
          {item.price !== null && <>
            <span class="menu-leader" aria-hidden="true"></span>
            <p class="meta menu-price">{currency.format(item.price)} AUD</p>
          </>}
        </div>
        {item.note && <p>{item.note}</p>}
        <Reviews ratings={item.ratings} />
      </article>
    ))}
  </section>)}
</Layout>
