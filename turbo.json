{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig.json",
    "packages/reviews/src/**",
    "packages/reviews/assets/**",
    "packages/reviews/astro.config.mjs"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["dist/**"],
      "env": [
        "STRAVA_CLIENT_ID",
        "STRAVA_CLIENT_SECRET",
        "STRAVA_REFRESH_TOKEN"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [".astro/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@personal-sites/mood-board#build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["dist/**"],
      "env": ["VITE_RPC_TRANSPORT", "VITE_RPC_URL"]
    },
    "@personal-sites/mood-board#typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": ["node_modules/.tmp/*.tsbuildinfo"]
    }
  }
}
