{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig.json",
    "packages/reviews/src/**",
    "packages/reviews/assets/**",
    "packages/reviews/astro.config.mjs"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["dist/**"],
      "env": [
        "STRAVA_CLIENT_ID",
        "STRAVA_CLIENT_SECRET",
        "STRAVA_REFRESH_TOKEN"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [".astro/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
